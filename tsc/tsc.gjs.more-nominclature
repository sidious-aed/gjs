sc.add_provider(cssc, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
const list = builder.get_object("list");
sc = list.get_style_context();
sc.add_class("list")
sc.add_provider(cssc, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
